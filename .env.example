# Manga Translator Studio — Configuration des Clés API
# Copiez ce fichier vers `.env` et renseignez au moins un fournisseur.

# ============================================================================
# TRADUCTION PRINCIPALE (obligatoire — choisir UN provider)
# ============================================================================

# Option A : Google Gemini (recommandé — 1500 req/j gratuites)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B : OpenRouter (accès à plein de modèles, certains gratuits)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Option C : OpenAI direct (payant, qualité max)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option D : Endpoint personnalisé (Ollama local, vLLM, etc.)
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=llama3.2-vision

# ============================================================================
# RAFFINEMENT OPTIONNEL (désactivé par défaut)
# ============================================================================
# Activez pour une relecture stylistique après traduction.
# Consomme des requêtes supplémentaires.

REFINER_ENABLED=false
REFINER_PROVIDER=none
# REFINER_PROVIDER=groq        # Groq (rapide, gratuit)
# REFINER_PROVIDER=openrouter  # Même clé que traduction
# REFINER_PROVIDER=openai      # Payant

# Clés spécifiques au raffinement (si différentes de la traduction)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================================================
# PRÉFÉRENCES
# ============================================================================
DEFAULT_PROVIDER=auto
SRC_LANG=Japanese
TGT_LANG=French
REGISTER=standard
FONT_STYLE=bold
FIXED_FONT_SIZE=0
TEXT_COLOR=#000000
MASK_STYLE=smart
