# Manga Translator Studio — Configuration des Clés API
# Copiez ce fichier vers `.env` et renseignez au moins un fournisseur.

# ============================================================================
# TRADUCTION VISION PRINCIPALE (choisir au moins UN provider)
# ============================================================================

# Option A : Google Gemini (recommandé — 1500 req/j gratuites)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B : OpenRouter (multi-modèles : Nemotron, Qwen, GPT-4o, etc.)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Option C : Ollama Cloud ou Local (Gemma 4 31B, Nemotron 3 Nano, Llama 3.2 Vision)
# https://ollama.com
OLLAMA_API_KEY=

# Option D : NVIDIA NIM (Inférence Vision Llama 3.2 Vision, Nemotron 3.5 VL)
# https://build.nvidia.com
NVIDIA_API_KEY=

# Option E : OpenAI direct (officiel)
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Option F : Endpoint personnalisé (Ollama local, vLLM, etc.)
CUSTOM_BASE_URL=http://localhost:11434/v1
CUSTOM_API_KEY=
CUSTOM_MODEL=llama3.2-vision

# ============================================================================
# RAFFINEMENT STYLISTIQUE OPTIONNEL (désactivé par défaut)
# ============================================================================
# Activez pour une relecture stylistique après traduction.
# Consomme des requêtes supplémentaires.

REFINER_ENABLED=false
REFINER_PROVIDER=none
# REFINER_PROVIDER=groq        # Groq (rapide, gratuit)
# REFINER_PROVIDER=openrouter  # Même clé que traduction
# REFINER_PROVIDER=openai      # Payant

# Clé Groq (si utilisée pour le raffinement ou la vision)
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# ============================================================================
# PRÉFÉRENCES DE TRADUCTION & LETTRAGE
# ============================================================================
DEFAULT_PROVIDER=auto
SRC_LANG=Japanese
TGT_LANG=French
REGISTER=standard
FONT_STYLE=bold
FIXED_FONT_SIZE=0
TEXT_COLOR=#000000
MASK_STYLE=smart
MTS_STORAGE_DIR=
