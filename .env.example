# ============================================================================
# Manga Translator Studio — Configuration des Clés d'API Cloud (Exemple)
# Copiez ce fichier vers `.env` et renseignez au moins un fournisseur Vision.
# ============================================================================

# 1. Google Gemini (Recommandé — 1500 requêtes gratuites/jour sur aistudio.google.com)
GEMINI_API_KEY=your_gemini_key_here

# 2. OpenRouter (Modèles Vision gratuits :free ou payants sur openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_key_here

# 3. Groq (Optionnel — Raffinement ultra-rapide du français parlé sur groq.com)
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# 4. Fournisseurs Cloud Vision de Repli Optionnels (Ollama Cloud / NVIDIA NIM)
OLLAMA_API_KEY=your_ollama_cloud_key_here
NVIDIA_API_KEY=your_nvidia_nim_key_here

# 5. Endpoint Personnalisé OpenAI-compatible (Optionnel)
CUSTOM_BASE_URL=https://openrouter.ai/api/v1
CUSTOM_API_KEY=your_custom_key_here
CUSTOM_MODEL=google/gemma-4-31b-it:free

# 6. Préférences par défaut
DEFAULT_PROVIDER=auto
SRC_LANG=Japanese
TGT_LANG=French
FONT_STYLE=bold
FIXED_FONT_SIZE=0
TEXT_COLOR=#000000
MASK_STYLE=smart
